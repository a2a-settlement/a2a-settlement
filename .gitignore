__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.env
.env.*

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

node_modules/
package-lock.json
# The docs site is built from this repo, so its lockfile must be tracked:
# webpack is only a transitive dep of @docusaurus/core (^5.95.0), and unpinned
# resolution now picks a webpack whose ProgressPlugin schema rejects the options
# webpackbar sends, breaking the build.
!docs-site/package-lock.json

build/
dist/
*.egg-info/

.ipynb_checkpoints/

# Windows "Mark of the Web" artifacts sometimes appear when copied from NTFS.
*:Zone.Identifier

# Local credentials (test agents)
test_agents/.client_credentials.json
test_agents/.provider_credentials.json

